# Copy to .env (chmod 600). docker compose reads it automatically; never commit it.

# Public URL of the deployed site. Used at build time for canonical links, OG tags, sitemap, robots.txt.
SITE_URL=https://royalt.online

# Host port for the web container (bound to 127.0.0.1 only; Tailscale Funnel publishes it).
WEB_PORT=8080

# Stats service
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_CHANNEL_ID=UC4aCKFHOXtL0WdT3nkMSmrA
GITHUB_USER=theycallmek
# Optional: raises the GitHub API rate limit.
GITHUB_TOKEN=

# Homelab stats (docs/DEPLOY.md, "Homelab"). One entry per machine from `npm run homelab:token -- <id>`;
# single-quoted JSON on one line. Leave empty to hide the homelab stats (section shows "unavailable").
HOMELAB_NODES=
# HOMELAB_NODES='[{"id":"web","label":"web server","hw":"x86 laptop","tokenSha256":"<64 hex>"}]'
# Host address the ingest port (8788) is published on: this server's Tailscale IPv4 (`tailscale ip -4`).
INGEST_BIND=127.0.0.1

# Cloudflare Tunnel for the public domain (docs/DEPLOY.md, section 11). Enable the cloudflared service
# with COMPOSE_PROFILES=tunnel and paste the tunnel token (a secret) below.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=

# Push the stats snapshot to the Cloudflare Worker every minute (docs/DEPLOY.md section 13).
# URL: the Worker's workers.dev address + /api/stats. Token: the same value as the GitHub secret
# STATS_PUSH_TOKEN (`openssl rand -hex 32`). Leave empty to disable.
STATS_PUSH_URL=
STATS_PUSH_TOKEN=
