# Response headers for Cloudflare Workers Static Assets (the same rules as the Caddyfile).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://count.royalt.online; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com https://count.royalt.online; font-src 'self'; connect-src 'self' https://count.royalt.online; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
