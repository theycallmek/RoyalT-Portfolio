{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.mjs",
      "!**/*.astro",
      "!**/*.css",
      "!src/assets",
      "!src/content"
    ]
  }
}
