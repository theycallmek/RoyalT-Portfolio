# Stats service: no npm deps, runs server/*.ts with Node's native type stripping.
FROM node:22.23.4-alpine
WORKDIR /app
COPY server/*.ts ./server/
RUN mkdir /data && chown node:node /data
ENV NODE_ENV=production PORT=8787 CACHE_FILE=/data/github.json YOUTUBE_CACHE_FILE=/data/youtube.json \
    HOMELAB_CACHE_FILE=/data/homelab.json INGEST_HOST=0.0.0.0 INGEST_PORT=8788
VOLUME /data
USER node
EXPOSE 8787 8788
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -qO- http://127.0.0.1:8787/api/health || exit 1
CMD ["node", "server/index.ts"]
