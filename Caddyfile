# Plain HTTP: TLS is terminated in front of this container by Cloudflare (royalt.online, via the
# cloudflared tunnel) or Tailscale Funnel (backup *.ts.net address).
:80 {
  # www -> apex, one canonical address
  @www host www.royalt.online
  redir @www https://royalt.online{uri} permanent

  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
  }

  handle /api/* {
    reverse_proxy stats:8787
  }

  handle {
    root * /srv
    @assets path /_astro/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle_errors {
    root * /srv
    rewrite * /404.html
    file_server
  }
}
