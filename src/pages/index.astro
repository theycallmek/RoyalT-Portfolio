---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import ScrambleText from "../components/islands/ScrambleText";
import AtAGlance from "../components/dashboard/AtAGlance";
import CodeSection from "../components/sections/CodeSection.astro";
import MakeSection from "../components/sections/MakeSection.astro";
import WriteSection from "../components/sections/WriteSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";
import makerworld from "../data/makerworld.json";
---
<BaseLayout title="RoyalT Online">
  <div id="top" class="scroll-mt-20">
    <PageHeader path="~/" title="RoyalT">
      <h1 slot="title" class="display text-6xl sm:text-8xl" aria-label="RoyalT — web developer">
        <ScrambleText client:load text="RoyalT" from="Taylor" duration={1100} /><span class="cursor" aria-hidden="true">_</span>
      </h1>
      <div slot="intro" class="mt-6 max-w-prose">
        <p class="text-xl font-bold sm:text-2xl">Hi, my name is Taylor.</p>
        <p class="mt-3 text-dim">Developer and maker based in California. I specialize in mobile app automation, web development, embedded IoT systems, 3D CAD, and visual content creation. I am always building something new while learning more and bringing my ideas to life.</p>
      </div>
    </PageHeader>
    <AtAGlance client:load models={makerworld.models} />
  </div>
  <CodeSection />
  <MakeSection />
  <WriteSection />
  <AboutSection />
</BaseLayout>
