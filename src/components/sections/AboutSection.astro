---
import { getCollection } from "astro:content";
import { LINK_CATEGORIES } from "../../lib/schemas";
import Cell from "../ui/Cell.astro";
import Grid from "../ui/Grid.astro";
import LinkRows from "../ui/LinkRows.astro";
import MetricIcon from "../ui/MetricIcon";
import SectionHeader from "../ui/SectionHeader.astro";
import SubHeader from "../ui/SubHeader.astro";

const links = await getCollection("links");
const tech = [
  ["Software", "Python and Lua for automation, tools and Discord bots; web apps with TypeScript, React, Astro, PHP, HTML and CSS"],
  ["Mobile automation", "Android automation with ADB"],
  ["Embedded & IoT", "ESP32 LED lighting with WLED, 3D-printer firmware for Klipper, and LoRa radios"],
  ["3D design", "Models designed in Fusion 360, then printed on my Bambu Lab P1S, and published on MakerWorld"],
  ["Infrastructure", "Linux servers, Docker, OpenWrt, Tailscale, and Cloudflare. They run this site and the live stats above."],
];
---
<section id="about" aria-labelledby="about-title" class="scroll-mt-20 mb-20">
  <SectionHeader id="about" n={4} title="About" />
  <div class="mb-10 max-w-prose space-y-4 leading-relaxed">
    <p>
      I'm Taylor, a self-taught developer and maker located in California. Everything I know, I learned by
      building: picking a project I didn't yet know how to finish, then researching, testing, and breaking
      things until it worked. This practice has taken me from automating mobile games to running a small home
      lab with a fleet of servers.
    </p>
  </div>
  <SubHeader id="tech" title="Tech I work with" />
  <Grid cols={1}>
    {tech.map(([area, tools]) => (
      <Cell class="flex flex-col gap-1 sm:flex-row sm:gap-6">
        <span class="label flex w-44 shrink-0 items-center gap-3 self-start"><span class="text-3xl leading-none"><MetricIcon label={area} /></span>{area}</span>
        <span>{tools}</span>
      </Cell>
    ))}
  </Grid>
  <div class="mb-10 max-w-prose space-y-4 leading-relaxed">
    <p>
      I am proud to use AI in both my work and my hobbies. It helps me learn faster, explore ideas, catch
      mistakes, and ship more than I ever could alone. The ideas, decisions, and all final calls are still
      mine. This site itself was designed and built with AI programming tools.
    </p>
    <p>
      When I am not at my keyboard, I am usually 3D printing, designing LED art, writing, or playing with my
      two cats, Bear and Teddy.
    </p>
  </div>
  <SubHeader id="elsewhere" title="Elsewhere" />
  {LINK_CATEGORIES.map((c) => <LinkRows items={links.filter((l) => l.data.category === c)} label={c} />)}
</section>
