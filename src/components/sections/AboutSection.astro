---
import { getCollection } from "astro:content";
import { LINK_CATEGORIES } from "../../lib/schemas";
import Cell from "../ui/Cell.astro";
import Grid from "../ui/Grid.astro";
import LinkRows from "../ui/LinkRows.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import SubHeader from "../ui/SubHeader.astro";

const skills = ["Mobile app automation", "Web development", "Embedded IoT systems", "3D CAD", "Visual content creation"];
const links = await getCollection("links");
const tech = [
  ["Software", "Python and Lua for automation, tools and Discord bots; web apps with TypeScript, React, Astro, PHP, HTML and CSS"],
  ["Mobile automation", "Android automation with ADB"],
  ["Embedded & IoT", "ESP32 lighting with WLED, and tuning 3D-printer firmware with Klipper"],
  ["3D design", "Models designed in Fusion 360, then printed and published on MakerWorld"],
  ["Infrastructure", "Linux servers, Docker, OpenWrt routers, Tailscale and Cloudflare. They run this site and the live stats above."],
];
---
<section id="about" aria-labelledby="about-title" class="scroll-mt-20 mb-20">
  <SectionHeader id="about" n={4} title="About" />
  <div class="mb-10 max-w-prose space-y-4 leading-relaxed">
    <p>
      I'm Taylor, a self-taught developer and maker based in California. Everything I know I learned by
      building: picking a project I didn't yet know how to finish, then reading, testing and breaking things
      until it worked. That habit has taken me from automating mobile apps to running my own small fleet of
      home servers.
    </p>
  </div>
  <SubHeader id="tech" title="Tech I work with" />
  <Grid cols={1}>
    {tech.map(([area, tools]) => (
      <Cell class="flex flex-col gap-1 sm:flex-row sm:gap-6">
        <span class="label w-44 shrink-0 pt-0.5">{area}</span>
        <span>{tools}</span>
      </Cell>
    ))}
  </Grid>
  <div class="mb-10 max-w-prose space-y-4 leading-relaxed">
    <p>
      I proudly use AI in both my work and my hobbies. I treat it like a sharp, tireless collaborator: it
      helps me learn faster, explore ideas, catch mistakes and ship more than I could alone. The ideas,
      decisions and final calls are still mine. This site itself was designed and built with an AI pair
      programmer.
    </p>
    <p>When I'm not at a keyboard, I'm usually designing and printing something new, or recording it for YouTube.</p>
  </div>
  <SubHeader id="skills" title="Skills" />
  <Grid cols={4}>
    {/* 5 skills in a 4-col grid: the last one fills its row so the ruled grid stays closed */}
    {skills.map((s, i) => <Cell span={i === skills.length - 1 && skills.length % 4 === 1 ? 4 : 1}>{s}</Cell>)}
  </Grid>
  <SubHeader id="elsewhere" title="Elsewhere" />
  {LINK_CATEGORIES.map((c) => <LinkRows items={links.filter((l) => l.data.category === c)} label={c} />)}
</section>
